# Gradle & Build outputs
.gradle/
build/
app/build/
app/.cxx/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_

# IDE & Local configuration
.idea/
*.iml
*.ipr
*.iws
local.properties
.vscode/

# Signing & Secrets (never commit production keys or Firebase configs)
*.jks
*.keystore
app/google-services.json

# Proprietary Rockstar GTA:SA Android v2.10 binaries & APK assets
# Populated locally via tools/prepare_gtasa.py from your own GTA:SA v2.10 APK (never commit)
app/src/main/jniLibs/*/libGTASA.so
app/src/main/jniLibs/*/libImmEmulatorJ.so
app/src/main/assets/*
!app/src/main/assets/monetloader_lib.zip
# 2026-11-22: WebView 覆盖层的本地壳页是源码，不是解包出来的游戏资源
!app/src/main/assets/web/
!app/src/main/assets/web/**

# OS & Temp files
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
nul
__pycache__/
*.pyc

# Local game data (large / copyrighted - keep out of VCS)
Android/
GTA/
gamefiles/
gamefiles.tar
dist/

# CEF 测试基建的运行产物（截图 / 日志 / 录包），不入库
tools/cef_kat/out/
tools/cef_kat/out_*/

# 从设备提取的二进制（受版权保护，禁止入库）
tools/_so/

# 编辑器 / 备份残留
*.bak_wv
*.bak_webview
